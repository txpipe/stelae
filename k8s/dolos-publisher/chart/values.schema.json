{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["network", "repo", "concurrency", "dolosToml", "image", "resources"],
  "properties": {
    "directS3SecretName": { "type": "string" },
    "network": { "type": "string", "minLength": 1 },
    "run": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[1-9][0-9]*$" },
        { "const": "" },
        { "type": "null" }
      ]
    },
    "schedule": { "type": "string" },
    "suspend": { "type": "boolean" },
    "startingDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
    "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
    "activeDeadlineSeconds": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "repo": { "type": "string", "pattern": "^oci://[^/]+/.+" },
    "concurrency": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[1-9][0-9]*$" }
      ]
    },
    "dolosToml": { "type": "string", "minLength": 1 },
    "stateEpochs": {
      "description": "Removed with retained state dumps; delete it from the values file.",
      "not": {}
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "ghcr.io/txpipe/dolos" }
        },
        "tag": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "allowGenesisFallback": { "type": "boolean" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "storageClassName": { "type": "string" },
        "existingClaim": { "type": "string" }
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "properties": {
        "epochs": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 2 },
            { "type": "string", "pattern": "^([2-9]|[1-9][0-9]+)$" }
          ]
        },
        "scratchMib": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^[1-9][0-9]*$" }
          ]
        },
        "reserveMib": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^[1-9][0-9]*$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "insecure": { "type": "boolean" },
    "publisherSecretName": { "type": "string", "minLength": 1 },
    "backoffLimit": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "resources": { "type": "object", "minProperties": 1 }
  },
  "if": { "properties": { "schedule": { "const": "" } } },
  "then": {
    "required": ["run"],
    "properties": {
      "run": {
        "oneOf": [
          { "type": "integer", "minimum": 1 },
          { "type": "string", "pattern": "^[1-9][0-9]*$" }
        ]
      }
    }
  },
  "additionalProperties": true
}
